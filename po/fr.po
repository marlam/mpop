#, c-format
msgid "  --filter=[program]           set/unset header filter\n"
msgstr "  --filter=[programme]         définir/annuler le filtre par en-tête\n"

#: src/mpop.c:2489
#, c-format
msgid "  --delivery=method,arg        set the mail delivery method\n"
msgstr "  --delivery=méthode,arg       définir la méthode de livraison du courriel\n"

