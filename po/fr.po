#, c-format
msgid "  -n, --only-new[=(on|off)]    process only new messages\n"
msgstr "  -n, --only-new[=(on|off)]    traiter uniquement les nouveaux messages\n"

#: src/mpop.c:2485
#, c-format
msgid "  -k, --keep[=(on|off|time)]   do not delete mails from servers (for a given time)\n"
msgstr "  -k, --keep[=(on|off|temps)]  ne pas supprimer les courriels des serveurs (pour une durée déterminée)\n"

